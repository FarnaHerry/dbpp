<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="db++" Manufacturer="dev.farna.dbpp" Version="@HUXERUI_WINDOWS_PROJECT_VERSION@"
           UpgradeCode="@HUXERUI_WINDOWS_MSI_UPGRADE_CODE@" Scope="perMachine">
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of db++ is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ApplicationIcon" SourceFile="@HUXERUI_WINDOWS_ICON_FILE@" />
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />
    <Property Id="MSIRMSHUTDOWN" Value="0" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="db++" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPLICATIONPROGRAMMENU" Name="db++" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Application)\**" />
    </ComponentGroup>
    <Component Id="ApplicationShortcut" Directory="APPLICATIONPROGRAMMENU">
      <Shortcut Id="ApplicationStartMenuShortcut" Name="db++"
                Target="[INSTALLFOLDER]dbpp.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ApplicationIcon" />
      <RemoveFolder Id="RemoveApplicationProgramMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\dev.farna.dbpp\db++" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ApplicationDesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="ApplicationDesktopShortcutLink" Name="db++"
                Target="[INSTALLFOLDER]dbpp.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ApplicationIcon" />
      <RegistryValue Root="HKLM" Key="Software\dev.farna.dbpp\db++" Name="desktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ApplicationPath" Directory="INSTALLFOLDER">
      <Environment Id="ApplicationPathEnv" Name="PATH" Value="[INSTALLFOLDER]"
                   Permanent="no" Part="last" Action="set" System="yes" />
      <RegistryValue Root="HKLM" Key="Software\dev.farna.dbpp\db++" Name="path"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Application" Title="db++" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationPath" />
    </Feature>
    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="2" AllowAbsent="yes">
      <Level Value="1" Condition="CREATE_DESKTOP_SHORTCUT = 1" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
    </Feature>
  </Package>
</Wix>
